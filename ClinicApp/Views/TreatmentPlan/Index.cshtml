@using ClinicApp.ViewModel
@model TreatmentPlanIndexModelView

@{
    ViewData["Title"] = "Treatment Plans Directory";
    int totalPages = (int)Math.Ceiling((double)Model.PauseCount / Model.PageSize);
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Top Header Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-journal-medical me-2"></i>Treatment Plans Directory
            </h5>
            <a asp-action="Create" class="btn btn-sm btn-primary px-3">
                <i class="bi bi-plus-lg me-1"></i> New Treatment Plan
            </a>
        </div>
    </div>

    <!-- Summary Stats Card -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body p-3">
                    <span class="text-muted extra-small d-block text-uppercase fw-bold">Total Treatment Plans</span>
                    <span class="fs-4 fw-bold text-primary">@Model.PauseCount</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content & Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <!-- Treatment Plans Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Level</th>
                            <th>Notes</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model._items != null && Model._items.Any())
                        {
                            foreach (var item in Model._items)
                            {
                                <tr>
                                    <td class="fw-bold">#@item.ID</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.Category</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">@item.Level</span>
                                    </td>
                                    <td class="small text-muted" style="max-width: 250px;">
                                        @(string.IsNullOrEmpty(item.Notes) ? "—" : item.Notes)
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-delete"
                                                    data-id="@item.ID"
                                                    data-name="@item.Name"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> No treatment plans found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Server-Side Pagination -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageIndex="@(Model.PageIndex - 1)"
                               asp-route-PageSize="@Model.PageSize">Previous</a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageIndex="@i"
                                   asp-route-PageSize="@Model.PageSize">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageIndex >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageIndex="@(Model.PageIndex + 1)"
                               asp-route-PageSize="@Model.PageSize">Next</a>
                        </li>
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel text-white">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Are you sure you want to delete this treatment plan?</p>
                <p class="fw-bold text-dark mb-0" id="deleteItemName"></p>
                <small class="text-danger">This action cannot be undone.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>

                <form id="deleteForm" asp-action="Delete" method="post" class="d-inline">
                    <input type="hidden" id="deleteItemId" name="id" value="" />
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteItemIdInput = document.getElementById('deleteItemId');
            const deleteItemNameText = document.getElementById('deleteItemName');

            document.querySelectorAll('.btn-delete').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');

                    deleteItemIdInput.value = id;
                    deleteItemNameText.textContent = `"${name}" (#${id})`;

                    deleteModal.show();
                });
            });
        });
    </script>
}