@using ClinicApp.ViewModel
@model TreatmentPlanModelview

@{
    ViewData["Title"] = $"Treatment Plan: {Model.Name}";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Top Action Header -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <div>
                <h4 class="mb-1 fw-bold text-dark">
                    <i class="bi bi-journal-medical me-2 text-primary"></i>@Model.Name
                </h4>
                <span class="badge bg-info text-dark me-2">@Model.Category</span>
                <span class="badge bg-secondary">@Model.Level</span>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to List
                </a>
                <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Plan
                </a>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Plan Notes & Overview -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light border-0 py-3">
                    <h6 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-card-text me-2"></i>Plan Details & Notes
                    </h6>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold d-block">Plan ID</label>
                        <span class="fw-bold">#@Model.ID</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold d-block">Category</label>
                        <span class="fw-bold">@Model.Category</span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold d-block">Difficulty Level</label>
                        <span class="fw-bold">@Model.Level</span>
                    </div>
                    <div class="mb-0">
                        <label class="text-muted small fw-semibold d-block">Notes</label>
                        <p class="text-dark bg-light p-3 rounded small mb-0">
                            @(string.IsNullOrWhiteSpace(Model.Notes) ? "No additional notes provided for this treatment plan." : Model.Notes)
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Linked Exercises Table -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-activity me-2"></i>Assigned Exercises (@(Model.Exercises?.Count ?? 0))
                    </h6>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addExerciseModal">
                        <i class="bi bi-plus-lg me-1"></i> Assign Exercises
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">Exercise ID</th>
                                    <th>Name</th>
                                    <th class="text-end" style="width: 20%;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Exercises != null && Model.Exercises.Any())
                                {
                                    foreach (var ex in Model.Exercises)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">#@ex.ID</td>
                                            <td class="fw-bold text-dark">@ex.Name</td>
                                            <td class="text-end">
                                                <form asp-action="RemoveExercise" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="treatmentPlanId" value="@Model.ID" />
                                                    <input type="hidden" name="exerciseId" value="@ex.ID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove Exercise">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-1"></i> No exercises assigned to this plan yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Exercises Modal -->
<div class="modal fade" id="addExerciseModal" tabindex="-1" aria-labelledby="addExerciseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddExercises" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="treatmentPlanId" value="@Model.ID" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addExerciseModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>Assign Exercises to Plan
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Select the exercises you wish to attach to this treatment plan:</p>

                    @if (Model.AllExercises != null && Model.AllExercises.Any())
                    {
                        var assignedIds = Model.Exercises?.Select(e => e.ID).ToHashSet() ?? new HashSet<int>();

                        <div class="list-group max-vh-50 overflow-auto border rounded">
                            @foreach (var ex in Model.AllExercises)
                            {
                                bool isAlreadyAssigned = assignedIds.Contains(ex.ID);

                                <label class="list-group-item d-flex align-items-center gap-3 cursor-pointer @(isAlreadyAssigned ? "bg-light text-muted" : "")">
                                    <input class="form-check-input flex-shrink-0"
                                           type="checkbox"
                                           name="exerciseIds"
                                           value="@ex.ID"
                                    @(isAlreadyAssigned ? "checked disabled" : "") />
                                    <div class="w-100">
                                        <span class="fw-semibold text-dark">@ex.Name</span>
                                        <small class="text-muted d-block">ID: #@ex.ID</small>
                                    </div>
                                    @if (isAlreadyAssigned)
                                    {
                                        <span class="badge bg-secondary">Already Assigned</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">No exercises available in system repository.</div>
                    }
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success px-4">
                        <i class="bi bi-check-lg me-1"></i> Add Selected Exercises
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Are you sure you want to delete this treatment plan?</p>
                <p class="fw-bold text-dark mb-0">"@Model.Name" (#@Model.ID)</p>
                <small class="text-danger">This action cannot be undone.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.ID" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>