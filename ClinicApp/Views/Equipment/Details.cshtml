@model ClinicApp.ViewModel.EquipmentViewModel

@{
    ViewData["Title"] = $"Equipment Details - {Model.Name}";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Top Navigation & Actions -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Directory
                </a>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Equipment
                </a>
                <button type="button" class="btn btn-sm btn-outline-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#deleteConfirmModal"
                        data-id="@Model.Id"
                        data-name="@Model.Name">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Primary Equipment Details -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-info-circle me-2"></i>Equipment Overview
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <span class="text-muted d-block small">Equipment ID</span>
                        <span class="fw-bold fs-5 text-dark">#@Model.Id</span>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small">Equipment Name</span>
                        <span class="fw-semibold fs-5 text-dark">@Model.Name</span>
                    </div>

                    <div class="mb-3">
                        <span class="text-muted d-block small">Merchant / Supplier</span>
                        <span class="fw-semibold fs-6 text-dark">
                            <i class="bi bi-shop me-1 text-secondary"></i>
                            @(string.IsNullOrEmpty(Model.MerchantName) ? "Unspecified" : Model.MerchantName)
                        </span>
                    </div>

                    <hr />

                    <div>
                        <span class="text-muted d-block small">Unit Price</span>
                        <span class="fw-bold text-success fs-3">$@Model.price.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Associated Exercises -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-activity me-2"></i>Associated Exercises
                    </h5>
                    <span class="badge bg-primary rounded-pill">
                        @(Model.excersices?.Count ?? 0) Exercises
                    </span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 25%;">Exercise Name</th>
                                    <th style="width: 20%;">Category</th>
                                    <th style="width: 20%;">Difficulty</th>
                                    <th style="width: 35%;">Description</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.excersices != null && Model.excersices.Any())
                                {
                                    foreach (var exercise in Model.excersices)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@exercise.Name</td>
                                            <td>
                                                <span class="badge bg-info text-dark">
                                                    @(string.IsNullOrEmpty(exercise.CategoryName) ? "General" : exercise.CategoryName)
                                                </span>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">
                                                    @exercise.Difficulty
                                                </span>
                                            </td>
                                            <td class="small text-muted">
                                                @(string.IsNullOrEmpty(exercise.Description) ? "—" : exercise.Description)
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-1"></i> No exercises are assigned to this equipment yet.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Confirm Delete -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <input type="hidden" id="deleteItemId" name="id" value="@Model.Id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger" id="deleteConfirmModalLabel">Confirm Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Are you sure you want to delete <strong>"@Model.Name"</strong>?</p>
                    <span class="text-muted small">This action will soft-delete the equipment record.</span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger px-4">Yes, Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>