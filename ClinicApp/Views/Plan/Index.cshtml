@using ClinicApp.ViewModel
@model PlanIndexModelView

@{
    ViewData["Title"] = "Treatment Plans Directory";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <div class="card shadow-sm border-0">
        <!-- Card Header with Add Button -->
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-layers me-2"></i>Treatment Plans Directory
            </h5>
            <a asp-action="Create" class="btn btn-sm btn-primary px-3">
                <i class="bi bi-plus-lg me-1"></i> Add New Plan
            </a>
        </div>

        <div class="card-body p-4">
            <!-- Data Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">ID</th>
                            <th style="width: 40%;">Plan Name</th>
                            <th style="width: 20%;">Sessions Count</th>
                            <th style="width: 15%;">Price</th>
                            <th style="width: 15%;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model._items != null && Model._items.Any())
                        {
                            foreach (var item in Model._items)
                            {
                                <tr>
                                    <td class="fw-bold text-secondary">#@item.ID</td>
                                    <td class="fw-semibold text-dark">@item.Name</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-clock-history me-1"></i>
                                            @(item.numberOfSession.HasValue ? $"{item.numberOfSession} Sessions" : "Unspecified")
                                        </span>
                                    </td>
                                    <td class="fw-bold text-success">
                                        @(item.Price.HasValue ? $"${item.Price.Value.ToString("0.00")}" : "Free / N/A")
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <!-- View Details -->
                                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-info" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <!-- Update / Edit -->
                                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary" title="Edit Plan">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!-- Delete (Modal Confirmation) -->
                                            <button type="button"
                                                    class="btn btn-outline-danger"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deletePlanModal"
                                                    data-id="@item.ID"
                                                    data-name="@item.Name"
                                                    title="Delete Plan">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> No treatment plans available. Click <strong>Add New Plan</strong> above to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Server-Side Pagination -->
            @if (Model.PageCount > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber - 1)">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.PageCount; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageNumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.PageCount ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Modal: Soft Delete Confirmation -->
<div class="modal fade" id="deletePlanModal" tabindex="-1" aria-labelledby="deletePlanModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Delete" method="post">
                <input type="hidden" id="deletePlanId" name="id" />
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-danger" id="deletePlanModalLabel">Confirm Plan Deletion</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Are you sure you want to delete <strong id="deletePlanName"></strong>?</p>
                    <span class="text-muted small">This action will soft-delete the treatment plan.</span>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-danger px-4">Delete Plan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteModal = document.getElementById('deletePlanModal');
            if (deleteModal) {
                deleteModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const name = button.getAttribute('data-name');

                    document.getElementById('deletePlanId').value = id;
                    document.getElementById('deletePlanName').textContent = `"${name}" (ID: #${id})`;
                });
            }
        });
    </script>
}