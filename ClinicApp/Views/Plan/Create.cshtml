@model ClinicApp.ViewModel.PlanDetailsModelView

@{
    ViewData["Title"] = "Add Treatment Plan";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />w

    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white">
                        <i class="bi bi-layers me-2"></i>Add New Treatment Plan
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-light">
                        <i class="bi bi-arrow-left me-1"></i> Back to Directory
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createPlanForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. Plan Name -->
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Name" class="form-control form-control-sm" placeholder="e.g. Standard Physical Therapy Package" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <!-- 2. Number of Sessions -->
                        <div class="mb-3">
                            <label asp-for="numberOfSession" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group input-group-sm">
                                <input asp-for="numberOfSession" type="number" min="1" max="100" class="form-control" placeholder="1 - 100" />
                                <span class="input-group-text bg-light">Sessions</span>
                            </div>
                            <span asp-validation-for="numberOfSession" class="text-danger small"></span>
                        </div>

                        <!-- 3. Plan Price -->
                        <div class="mb-4">
                            <label asp-for="Price" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-light">$</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-sm btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Plan
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}