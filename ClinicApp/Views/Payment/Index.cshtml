
@model PaymentIndexModelView

@{
    ViewData["Title"] = "Payment Transactions Directory";

    decimal totalCredit = Model._items?.Where(p => p.IsCredit).Sum(p => p.Amount) ?? 0;
    decimal totalDebit = Model._items?.Where(p => !p.IsCredit).Sum(p => p.Amount) ?? 0;
    decimal netBalance = totalCredit - totalDebit;
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Top Header Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-cash-stack me-2"></i>Payment Transactions Directory
            </h5>
        </div>
    </div>

    <!-- Financial Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body p-3">
                    <span class="text-muted extra-small d-block text-uppercase fw-bold">Filtered Credit Income</span>
                    <span class="fs-4 fw-bold text-success">$@totalCredit.ToString("0.00")</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body p-3">
                    <span class="text-muted extra-small d-block text-uppercase fw-bold">Filtered Debit Expenses</span>
                    <span class="fs-4 fw-bold text-danger">$@totalDebit.ToString("0.00")</span>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-light">
                <div class="card-body p-3">
                    <span class="text-muted extra-small d-block text-uppercase fw-bold">Net Filtered Balance</span>
                    <span class="fs-4 fw-bold @(netBalance >= 0 ? "text-primary" : "text-danger")">$@netBalance.ToString("0.00")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content & Filters Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <!-- Filter Form -->
            <form asp-action="Index" method="get" class="mb-4" id="paymentFilterForm">
                <input type="hidden" name="PageNumber" value="1" />

                <!-- Row 1: Search, Date Range, Credit/Debit Select -->
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted fw-semibold">Search Query</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input type="text" name="SearchWord" value="@Model.SearchWord" class="form-control" placeholder="Search amount, notes, names..." />
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-muted fw-semibold">From Date</label>
                        <input type="date" name="FromDate"
                               value="@(Model.FromDate.HasValue && Model.FromDate != DateOnly.MinValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control form-control-sm" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small text-muted fw-semibold">To Date</label>
                        <input type="date" name="ToDate"
                               value="@(Model.ToDate.HasValue && Model.ToDate != DateOnly.MaxValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")"
                               class="form-control form-control-sm" />
                    </div>

                    <!-- STRING-BASED ISCREDIT SELECT -->
                    <div class="col-md-2">
                        <label class="form-label small text-muted fw-semibold">Credit / Debit</label>
                        <select asp-for="IsCreditFilter"
                                asp-items="Html.GetEnumSelectList<Paymentfilter>()"
                                class="form-select form-select-sm">
                            <option value="">-- All Types --</option>
                        </select>
                    </div>

                    <div class="col-md-1.5 col-sm-6">
                        <label class="form-label small text-muted fw-semibold">Payment Method</label>
                        <select asp-for="PaymentMethodFilter"
                                asp-items="Html.GetEnumSelectList<PaymentMethod>()"
                                name="PaymentMethodFilter"
                                class="form-select form-select-sm">
                            <option value="">-- All Methods --</option>
                        </select>
                    </div>

                    <div class="col-md-1.5 col-sm-6">
                        <label class="form-label small text-muted fw-semibold">Payment Type</label>
                        <select asp-for="PaymentTypeFilter"
                                asp-items="Html.GetEnumSelectList<PaymentType>()"
                                name="PaymentTypeFilter"
                                class="form-select form-select-sm">
                            <option value="">-- All Types --</option>
                        </select>
                    </div>
                </div>

                <!-- Row 2: Multi-Select Filter Boxes (Therapists, Patients, Receptionists, Medical Services) -->
                <div class="row g-3 mb-4">
                    <!-- Therapists Filter -->
                    <div class="col-md-3">
                        <label class="form-label small text-muted fw-semibold d-block mb-1">Therapists</label>
                        <input type="text" class="form-control form-control-sm mb-2 filter-search-input" data-target="therapistList" placeholder="Search therapist..." />
                        <div class="border rounded bg-white p-2" style="max-height: 130px; overflow-y: auto;" id="therapistList">
                            @if (Model.allTherapists != null && Model.allTherapists.Any())
                            {
                                foreach (var item in Model.allTherapists)
                                {
                                    bool isChecked = Model.TherpaistSIDFilter != null && Model.TherpaistSIDFilter.Contains(item.id);
                                    <div class="form-check py-1 mb-0 filter-item">
                                        <input class="form-check-input" type="checkbox" name="TherpaistSIDFilter" value="@item.id" id="th_@item.id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small text-dark filter-label" for="th_@item.id">@item.nametag</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small py-1 text-center">No therapists found.</div>
                            }
                        </div>
                    </div>

                    <!-- Patients Filter -->
                    <div class="col-md-3">
                        <label class="form-label small text-muted fw-semibold d-block mb-1">Patients</label>
                        <input type="text" class="form-control form-control-sm mb-2 filter-search-input" data-target="patientList" placeholder="Search patient..." />
                        <div class="border rounded bg-white p-2" style="max-height: 130px; overflow-y: auto;" id="patientList">
                            @if (Model.allPatients != null && Model.allPatients.Any())
                            {
                                foreach (var item in Model.allPatients)
                                {
                                    bool isChecked = Model.PatientIDsFilter != null && Model.PatientIDsFilter.Contains(item.id);
                                    <div class="form-check py-1 mb-0 filter-item">
                                        <input class="form-check-input" type="checkbox" name="PatientIDsFilter" value="@item.id" id="pt_@item.id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small text-dark filter-label" for="pt_@item.id">@item.nametag</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small py-1 text-center">No patients found.</div>
                            }
                        </div>
                    </div>

                    <!-- Receptionists Filter -->
                    <div class="col-md-3">
                        <label class="form-label small text-muted fw-semibold d-block mb-1">Receptionists</label>
                        <input type="text" class="form-control form-control-sm mb-2 filter-search-input" data-target="receiptList" placeholder="Search receptionist..." />
                        <div class="border rounded bg-white p-2" style="max-height: 130px; overflow-y: auto;" id="receiptList">
                            @if (Model.allRecipts != null && Model.allRecipts.Any())
                            {
                                foreach (var item in Model.allRecipts)
                                {
                                    bool isChecked = Model.ReciptIDsFilter != null && Model.ReciptIDsFilter.Contains(item.id);
                                    <div class="form-check py-1 mb-0 filter-item">
                                        <input class="form-check-input" type="checkbox" name="ReciptIDsFilter" value="@item.id" id="rc_@item.id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small text-dark filter-label" for="rc_@item.id">@item.nametag</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small py-1 text-center">No receptionists found.</div>
                            }
                        </div>
                    </div>

                    <!-- Medical Services Filter -->
                    <div class="col-md-3">
                        <label class="form-label small text-muted fw-semibold d-block mb-1">Medical Services</label>
                        <input type="text" class="form-control form-control-sm mb-2 filter-search-input" data-target="serviceList" placeholder="Search medical service..." />
                        <div class="border rounded bg-white p-2" style="max-height: 130px; overflow-y: auto;" id="serviceList">
                            @if (Model.allMedicalService != null && Model.allMedicalService.Any())
                            {
                                foreach (var item in Model.allMedicalService)
                                {
                                    bool isChecked = Model.medicalServiceIDsFilter != null && Model.medicalServiceIDsFilter.Contains(item.id);
                                    <div class="form-check py-1 mb-0 filter-item">
                                        <input class="form-check-input" type="checkbox" name="medicalServiceIDsFilter" value="@item.id" id="ms_@item.id" @(isChecked ? "checked" : "") />
                                        <label class="form-check-label small text-dark filter-label" for="ms_@item.id">@item.nametag</label>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small py-1 text-center">No medical services found.</div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Action Controls -->
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-3">Reset Filters</a>
                    <button type="submit" class="btn btn-sm btn-primary px-4">
                        <i class="bi bi-funnel me-1"></i> Apply Filters
                    </button>
                </div>
            </form>

            <!-- Payments Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Amount</th>
                            <th>Credit / Debit</th>
                            <th>Method & Type</th>
                            <th>Date</th>
                            <th>Entities Involved</th>
                            <th class="text-end">Notes</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model._items != null && Model._items.Any())
                        {
                            foreach (var pmt in Model._items)
                            {
                                <tr>
                                    <td class="fw-bold">#@pmt.ID</td>
                                    <td class="fw-bold fs-6 @(pmt.IsCredit ? "text-success" : "text-danger")">
                                        $@pmt.Amount.ToString("0.00")
                                    </td>
                                    <td>
                                        @if (pmt.IsCredit)
                                        {
                                            <span class="badge bg-success">Credit</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Debit</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark d-block mb-1 w-auto">@pmt.Method</span>
                                        <span class="badge bg-light text-dark border d-block w-auto">@pmt.PaymentType</span>
                                    </td>
                                    <td class="small">
                                        @pmt.Date.ToString("dd MMM yyyy HH:mm")
                                    </td>
                                    <td class="extra-small">
                                        @if (pmt.PatientID.HasValue)
                                        {
                                            <div>
                                                <span class="text-muted">Patient:</span>
                                                <a asp-controller="Patient" asp-action="Details" asp-route-id="@pmt.PatientID" class="fw-bold text-primary text-decoration-none">
                                                    @pmt.PatientName <i class="bi bi-box-arrow-up-right extra-small"></i>
                                                </a>
                                            </div>
                                        }
                                        @if (pmt.TherapistID.HasValue)
                                        {
                                            <div>
                                                <span class="text-muted">Therapist:</span>
                                                <a asp-controller="Therapist" asp-action="Details" asp-route-id="@pmt.TherapistID" class="fw-bold text-primary text-decoration-none">
                                                    @pmt.TherapistName <i class="bi bi-box-arrow-up-right extra-small"></i>
                                                </a>
                                            </div>
                                        }
                                        @if (pmt.MedicalServiceID.HasValue)
                                        {
                                            <div><span class="text-muted">Service:</span> <strong class="text-dark">@pmt.medicalServiceName</strong></div>
                                        }
                                        @if (pmt.ReceptID.HasValue)
                                        {
                                            <div>
                                                <span class="text-muted">Receptionist:</span>
                                                <a asp-controller="Receptionist" asp-action="Details" asp-route-id="@pmt.ReceptID" class="fw-bold text-primary text-decoration-none">
                                                    @pmt.ReceptName <i class="bi bi-box-arrow-up-right extra-small"></i>
                                                </a>
                                            </div>
                                        }
                                        @if (pmt.AppointmentID.HasValue)
                                        {
                                            <div>
                                                <span class="text-muted">Appt:</span>
                                                <a asp-controller="Appointment" asp-action="Details" asp-route-id="@pmt.AppointmentID" class="fw-bold text-primary text-decoration-none">
                                                    #@pmt.AppointmentID <i class="bi bi-box-arrow-up-right extra-small"></i>
                                                </a>
                                            </div>
                                        }
                                    </td>
                                    <td class="text-end small text-muted" style="max-width: 180px;">
                                        @(string.IsNullOrEmpty(pmt.Notes) ? "—" : pmt.Notes)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> No payment records found matching your filter criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Server-Side Pagination -->
            @if (Model.pageCount > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber - 1)"
                               asp-route-SearchWord="@Model.SearchWord"
                               asp-route-IsCredit="@Model.IsCreditFilter"
                               asp-route-PaymentMethodFilter="@Model.PaymentMethodFilter"
                               asp-route-PaymentTypeFilter="@Model.PaymentTypeFilter">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.pageCount; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageNumber="@i"
                                   asp-route-SearchWord="@Model.SearchWord"
                                   asp-route-IsCredit="@Model.IsCreditFilter"
                                   asp-route-PaymentMethodFilter="@Model.PaymentMethodFilter"
                                   asp-route-PaymentTypeFilter="@Model.PaymentTypeFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.pageCount ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-SearchWord="@Model.SearchWord"
                               asp-route-IsCredit="@Model.IsCreditFilter"
                               asp-route-PaymentMethodFilter="@Model.PaymentMethodFilter"
                               asp-route-PaymentTypeFilter="@Model.PaymentTypeFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Live Search script for multi-select filter containers
            const searchInputs = document.querySelectorAll(".filter-search-input");

            searchInputs.forEach(input => {
                input.addEventListener("input", function() {
                    const targetId = this.getAttribute("data-target");
                    const container = document.getElementById(targetId);
                    const term = this.value.toLowerCase().trim();
                    const items = container.querySelectorAll(".filter-item");

                    items.forEach(item => {
                        const label = item.querySelector(".filter-label").textContent.toLowerCase();
                        item.style.display = label.includes(term) ? "" : "none";
                    });
                });
            });
        });
    </script>
}