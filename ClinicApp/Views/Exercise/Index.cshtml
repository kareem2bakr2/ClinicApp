@using ClinicApp.ViewModel
@model ExcerciseIndexViewModel

@{
    ViewData["Title"] = "Exercises Directory";
    int totalPages = Model.totalPageCount > 0 ? Model.totalPageCount : 1;
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Header & Action Bar -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-activity me-2"></i>Exercises Directory
            </h5>
            <a asp-action="Create" class="btn btn-sm btn-primary px-3">
                <i class="bi bi-plus-lg me-1"></i> Add New Exercise
            </a>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <!-- Text Search -->
                    <div class="col-md-4">
                        <label asp-for="ssearchName" class="form-label fw-semibold small">Search Keywords</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input asp-for="ssearchName" class="form-control" placeholder="Search by name, description, category..." />
                        </div>
                    </div>

                    <!-- Difficulty Filter -->
                    <div class="col-md-3">
                        <label asp-for="difficultyFilter" class="form-label fw-semibold small">Difficulty Level</label>
                        <select asp-for="difficultyFilter"
                                asp-items="Html.GetEnumSelectList<ExerciseDifficulty>()"
                                class="form-select form-select-sm">
                            <option value="">-- All Difficulties --</option>
                        </select>
                    </div>

                    <!-- Min Sets Filter -->
                    <div class="col-md-2 col-6">
                        <label asp-for="NumberOfSetsMinFilter" class="form-label fw-semibold small">Min Sets</label>
                        <input asp-for="NumberOfSetsMinFilter" type="number" class="form-control form-control-sm" placeholder="Min" />
                    </div>

                    <!-- Max Sets Filter -->
                    <div class="col-md-2 col-6">
                        <label asp-for="NumberOfSetsMaxFilter" class="form-label fw-semibold small">Max Sets</label>
                        <input asp-for="NumberOfSetsMaxFilter" type="number" class="form-control form-control-sm" placeholder="Max" />
                    </div>

                    <!-- Actions -->
                    <div class="col-md-1 d-flex align-items-end gap-1">
                        <button type="submit" class="btn btn-sm btn-primary w-100" title="Apply Filters">
                            <i class="bi bi-filter"></i>
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Reset Filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Exercises Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 10%;">ID</th>
                            <th>Exercise Name</th>
                            <th>Category</th>
                            <th>Number of Sets</th>
                            <th>Difficulty</th>
                            <th class="text-end" style="width: 15%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.items != null && Model.items.Any())
                        {
                            foreach (var item in Model.items)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@item.ID</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-tag me-1"></i>@(string.IsNullOrEmpty(item.CategoryName) ? "Uncategorized" : item.CategoryName)
                                        </span>
                                    </td>
                                    <td>
                                        <span class="fw-semibold">@item.NumberOfSets</span> <small class="text-muted">sets</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@item.Difficulty</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-outline-info" title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-outline-primary" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-delete"
                                                    data-id="@item.ID"
                                                    data-name="@item.Name"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> No exercises found matching the selected filter criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Bar -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.pageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.pageNumber - 1)"
                               asp-route-pageSize="@Model.pageSize"
                               asp-route-ssearchName="@Model.ssearchName"
                               asp-route-difficultyFilter="@Model.difficultyFilter"
                               asp-route-NumberOfSetsMinFilter="@Model.NumberOfSetsMinFilter"
                               asp-route-NumberOfSetsMaxFilter="@Model.NumberOfSetsMaxFilter">Previous</a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(Model.pageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.pageSize"
                                   asp-route-ssearchName="@Model.ssearchName"
                                   asp-route-difficultyFilter="@Model.difficultyFilter"
                                   asp-route-NumberOfSetsMinFilter="@Model.NumberOfSetsMinFilter"
                                   asp-route-NumberOfSetsMaxFilter="@Model.NumberOfSetsMaxFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.pageNumber >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.pageNumber + 1)"
                               asp-route-pageSize="@Model.pageSize"
                               asp-route-ssearchName="@Model.ssearchName"
                               asp-route-difficultyFilter="@Model.difficultyFilter"
                               asp-route-NumberOfSetsMinFilter="@Model.NumberOfSetsMinFilter"
                               asp-route-NumberOfSetsMaxFilter="@Model.NumberOfSetsMaxFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Are you sure you want to delete this exercise?</p>
                <p class="fw-bold text-dark mb-0" id="deleteItemName"></p>
                <small class="text-danger">This action cannot be undone.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteItemId" name="id" value="" />
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const deleteItemIdInput = document.getElementById('deleteItemId');
            const deleteItemNameText = document.getElementById('deleteItemName');

            document.querySelectorAll('.btn-delete').forEach(button => {
                button.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');

                    deleteItemIdInput.value = id;
                    deleteItemNameText.textContent = `"${name}" (#${id})`;

                    deleteModal.show();
                });
            });
        });
    </script>
}
