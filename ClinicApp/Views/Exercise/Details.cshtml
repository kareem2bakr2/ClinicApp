@using ClinicApp.ViewModel
@model ExerciseDetailsModelView

@{
    ViewData["Title"] = $"Exercise Details - {Model.Name}";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Top Action Header -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <div>
                <h4 class="mb-1 fw-bold text-dark">
                    <i class="bi bi-activity me-2 text-primary"></i>@Model.Name
                </h4>
                <span class="badge bg-info text-dark me-2">Category: @(string.IsNullOrEmpty(Model.CategoryName) ? "N/A" : Model.CategoryName)</span>
                <span class="badge bg-secondary me-2">Difficulty: @Model.Difficulty</span>
                <span class="badge bg-light text-dark border">Sets: @Model.NumberOfSets</span>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Directory
                </a>
                <a asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-sm btn-primary">
                    <i class="bi bi-pencil me-1"></i> Edit Exercise
                </a>
                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteExerciseModal">
                    <i class="bi bi-trash me-1"></i> Delete
                </button>
            </div>
        </div>
    </div>

    <!-- Description & Instructions -->
    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light border-0 py-3">
                    <h6 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-info-circle me-2"></i>Exercise Information
                    </h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold d-block">Description</label>
                            <p class="text-dark bg-light p-3 rounded mb-0">
                                @(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided." : Model.Description)
                            </p>
                        </div>
                        <div class="col-md-6">
                            <label class="text-muted small fw-semibold d-block">Instructions</label>
                            <p class="text-dark bg-light p-3 rounded mb-0">
                                @(string.IsNullOrWhiteSpace(Model.Instructions) ? "No instructions provided." : Model.Instructions)
                            </p>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.VideoURL))
                        {
                            <div class="col-12 mt-3">
                                <label class="text-muted small fw-semibold d-block">Video Reference</label>
                                <a href="@Model.VideoURL" target="_blank" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-play-btn me-1"></i> Watch Demonstration Video
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Target Muscles -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-diagram-3 me-2"></i>Target Muscles (@(Model.SelectedMuscles?.Count ?? 0))
                    </h6>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addMuscleModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Muscles
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Muscle Name</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SelectedMuscles != null && Model.SelectedMuscles.Any())
                                {
                                    foreach (var m in Model.SelectedMuscles)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">#@m.ID</td>
                                            <td class="fw-bold text-dark">@m.Name</td>
                                            <td class="text-end">
                                                <form asp-action="RemoveMuscle" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="EXID" value="@Model.ID" />
                                                    <input type="hidden" name="MuscleID" value="@m.ID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove Muscle">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-1"></i> No target muscles assigned.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Required Equipment -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-light border-0 py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-tools me-2"></i>Required Equipment (@(Model.SelectedEquipments?.Count ?? 0))
                    </h6>
                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#addEquipmentModal">
                        <i class="bi bi-plus-lg me-1"></i> Add Equipment
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Equipment Name</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SelectedEquipments != null && Model.SelectedEquipments.Any())
                                {
                                    foreach (var eq in Model.SelectedEquipments)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">#@eq.ID</td>
                                            <td class="fw-bold text-dark">@eq.Name</td>
                                            <td class="text-end">
                                                <form asp-action="RemoveEquipment" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="EXID" value="@Model.ID" />
                                                    <input type="hidden" name="EquipID" value="@eq.ID" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger border-0" title="Remove Equipment">
                                                        <i class="bi bi-x-circle-fill"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-1"></i> No equipment required for this exercise.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Treatment Plans Section -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light border-0 py-3">
                    <h6 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-journal-medical me-2"></i>Associated Treatment Plans (@(Model.SelectedTreatmentPlans?.Count ?? 0))
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Plan ID</th>
                                    <th>Treatment Plan Name</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.SelectedTreatmentPlans != null && Model.SelectedTreatmentPlans.Any())
                                {
                                    foreach (var tp in Model.SelectedTreatmentPlans)
                                    {
                                        <tr>
                                            <td class="fw-bold text-muted">#@tp.ID</td>
                                            <td class="fw-bold text-dark">@tp.Name</td>
                                            <td class="text-end">
                                                <a asp-controller="TreatmentPlan" asp-action="Details" asp-route-id="@tp.ID" class="btn btn-sm btn-outline-info">
                                                    <i class="bi bi-eye me-1"></i> View Plan
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="3" class="text-center py-4 text-muted">
                                            <i class="bi bi-info-circle me-1"></i> This exercise is not attached to any treatment plans.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add Muscles -->
<div class="modal fade" id="addMuscleModal" tabindex="-1" aria-labelledby="addMuscleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddMuscle" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Exid" value="@Model.ID" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addMuscleModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>Add Muscles to Exercise
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Select muscles to link to this exercise:</p>

                    @if (Model.allMuscles != null && Model.allMuscles.Any())
                    {
                        var assignedMuscleIds = Model.SelectedMuscles?.Select(m => m.ID).ToHashSet() ?? new HashSet<int?>();

                        <div class="list-group max-vh-50 overflow-auto border rounded">
                            @foreach (var m in Model.allMuscles)
                            {
                                bool isAssigned = assignedMuscleIds.Contains(m.ID);

                                <label class="list-group-item d-flex align-items-center gap-3 cursor-pointer @(isAssigned ? "bg-light text-muted" : "")">
                                    <input class="form-check-input flex-shrink-0"
                                           type="checkbox"
                                           name="musclesIDs"
                                           value="@m.ID"
                                    @(isAssigned ? "checked disabled" : "") />
                                    <div class="w-100">
                                        <span class="fw-semibold text-dark">@m.Name</span>
                                    </div>
                                    @if (isAssigned)
                                    {
                                        <span class="badge bg-secondary">Already Added</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">No muscles available in the repository.</div>
                    }
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success px-4">
                        <i class="bi bi-check-lg me-1"></i> Save Selected
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Equipment -->
<div class="modal fade" id="addEquipmentModal" tabindex="-1" aria-labelledby="addEquipmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddEquipments" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Exid" value="@Model.ID" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="addEquipmentModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>Add Equipment to Exercise
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Select equipment items to link to this exercise:</p>

                    @if (Model.allEquipmetns != null && Model.allEquipmetns.Any())
                    {
                        var assignedEquipIds = Model.SelectedEquipments?.Select(e => e.ID).ToHashSet() ?? new HashSet<int?>();

                        <div class="list-group max-vh-50 overflow-auto border rounded">
                            @foreach (var eq in Model.allEquipmetns)
                            {
                                bool isAssigned = assignedEquipIds.Contains(eq.ID);

                                <label class="list-group-item d-flex align-items-center gap-3 cursor-pointer @(isAssigned ? "bg-light text-muted" : "")">
                                    <input class="form-check-input flex-shrink-0"
                                           type="checkbox"
                                           name="EquipmentsIDs"
                                           value="@eq.ID"
                                    @(isAssigned ? "checked disabled" : "") />
                                    <div class="w-100">
                                        <span class="fw-semibold text-dark">@eq.Name</span>
                                    </div>
                                    @if (isAssigned)
                                    {
                                        <span class="badge bg-secondary">Already Added</span>
                                    }
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-0">No equipment available in the repository.</div>
                    }
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-success px-4">
                        <i class="bi bi-check-lg me-1"></i> Save Selected
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Delete Exercise -->
<div class="modal fade" id="deleteExerciseModal" tabindex="-1" aria-labelledby="deleteExerciseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteExerciseModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Are you sure you want to delete this exercise?</p>
                <p class="fw-bold text-dark mb-0">"@Model.Name" (#@Model.ID)</p>
                <small class="text-danger">This action cannot be undone.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.ID" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1"></i> Delete Exercise
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>