@using ClinicApp.ViewModel
@model ExerciseDetailsModelView

@{
    ViewData["Title"] = $"Edit Exercise - {Model.Name}";
    var selectedEquipIds = Model.SelectedEquipments?.Select(e => e.ID).ToHashSet() ?? new HashSet<int?>();
    var selectedMuscleIds = Model.SelectedMuscles?.Select(m => m.ID).ToHashSet() ?? new HashSet<int?>();
}

<div class=" py-5 my-5">
    <partial name="_alerts" />

    <div class="row justify-content-center">
        <div class="col-lg-9 col-xl-8">

            <!-- Header Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body d-flex justify-content-between align-items-center py-3">
                    <h5 class="mb-0 fw-bold text-secondary">
                        <i class="bi bi-pencil-square me-2"></i>Edit Exercise
                    </h5>
                    <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel & Back to Details
                    </a>
                </div>
            </div>

            <!-- Form Card -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Hidden ID Field -->
                        <input type="hidden" asp-for="ID" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- Basic Information -->
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-1"></i> Basic Details</h6>

                        <div class="row g-3 mb-4">
                            <!-- Name -->
                            <div class="col-md-4">
                                <label asp-for="Name" class="form-label fw-semibold">Exercise Name <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="e.g., Barbell Bench Press" />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <!-- Category Dropdown -->
                            

                            <!-- Difficulty Enum Dropdown -->
                            <div class="col-md-4">
                                <label asp-for="Difficulty" class="form-label fw-semibold">Difficulty Level <span class="text-danger">*</span></label>
                                <select asp-for="Difficulty"
                                        asp-items="Html.GetEnumSelectList<ExerciseDifficulty>()"
                                        class="form-select">
                                    <option value="">-- Select Difficulty --</option>
                                </select>
                                <span asp-validation-for="Difficulty" class="text-danger small"></span>
                            </div>

                            <!-- Number of Sets -->
                            <div class="col-md-4">
                                <label asp-for="NumberOfSets" class="form-label fw-semibold">Default Sets <span class="text-danger">*</span></label>
                                <input asp-for="NumberOfSets" type="number" class="form-control" min="1" />
                                <span asp-validation-for="NumberOfSets" class="text-danger small"></span>
                            </div>

                            <!-- Video URL -->
                            <div class="col-12">
                                <label asp-for="VideoURL" class="form-label fw-semibold">Video URL</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                    <input asp-for="VideoURL" class="form-control" placeholder="https://youtube.com/watch?v=..." />
                                </div>
                                <span asp-validation-for="VideoURL" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Multi-Select Section -->
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-diagram-3 me-1"></i> Target Muscles & Equipment</h6>

                        <div class="row g-3 mb-4">
                            <!-- Target Muscles Checkboxes -->
                           
                            <div class="col-md-6">
                                <label class="form-label fw-semibold d-block">Target Muscles</label>
                                <div class="border rounded p-3 bg-light overflow-auto" style="max-height: 220px;">
                                    @if (Model.allMuscles != null && Model.allMuscles.Any())
                                    {
                                        foreach (var m in Model.allMuscles)
                                        {
                                            bool isChecked = selectedMuscleIds.Contains(m.ID);
                                            <div class="form-check mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedMuscles"
                                                       value="@m.ID"
                                                       id="muscle_@m.ID"
                                                @(isChecked ? "checked" : "") />
                                                <label class="form-check-label text-dark" for="muscle_@m.ID">
                                                    @m.Name
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <small class="text-muted">No muscle options available.</small>
                                    }
                                </div>
                            </div>
                            <!-- Category Muscles Checkboxes -->
                        <div class="col-md-6">
                        <label class="form-label fw-semibold d-block">Category</label>
                        <div class="border rounded p-3 bg-light overflow-auto" style="max-height: 220px;">
                            @if (Model.allcategories != null && Model.allcategories.Any())
                            {
                                foreach (var c in Model.allcategories)
                                {
                                    bool isChecked = Model.CategoryID == c.ID;
                                    <div class="form-check p-2 item-hover d-flex align-items-center gap-2 mb-1">
                                           @if (isChecked)
                                           {
                                               <input class="form-check-input flex-shrink-0 m-0"
                                               type="radio"
                                               asp-for="CategoryID"
                                               value="@c.ID"
                                               id="cat_@c.ID"
                                               checked />

                                                    }
                                                    else
                                                    {
                                               <input class="form-check-input flex-shrink-0 m-0"
                                               type="radio"
                                               asp-for="CategoryID"
                                               value="@c.ID"
                                               id="cat_@c.ID"
                                                />
         
                                           }



                                        <label class="form-check-label ml-md-4 text-dark fw-medium cursor-pointer w-100" for="cat_@c.ID">
                                            @c.Name
                                        </label>
                                    </div>
                                }
                            }
                            else
                            {
                                <small class="text-muted">No Categories options available.</small>
                            }
                        </div>
                        <span asp-validation-for="CategoryID" class="text-danger small"></span>
                    </div>
                            <!-- Required Equipment Checkboxes -->
                            <div class="col-md-6">
                                <label class="form-label fw-semibold d-block">Required Equipment</label>
                                <div class="border rounded p-3 bg-light overflow-auto" style="max-height: 220px;">
                                    @if (Model.allEquipmetns != null && Model.allEquipmetns.Any())
                                    {
                                        foreach (var eq in Model.allEquipmetns)
                                        {
                                            bool isChecked = selectedEquipIds.Contains(eq.ID);
                                            <div class="form-check mb-2">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       name="SelectedEquipments"
                                                       value="@eq.ID"
                                                       id="eq_@eq.ID"
                                                @(isChecked ? "checked" : "") />
                                                <label class="form-check-label text-dark" for="eq_@eq.ID">
                                                    @eq.Name
                                                </label>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <small class="text-muted">No equipment options available.</small>
                                    }
                                </div>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <!-- Description & Instructions -->
                        <h6 class="fw-bold text-primary mb-3"><i class="bi bi-card-text me-1"></i> Additional Guidance</h6>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="2" placeholder="Brief summary of movement..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Instructions" class="form-label fw-semibold">Step-by-Step Instructions</label>
                            <textarea asp-for="Instructions" class="form-control" rows="4" placeholder="Detailed step-by-step execution..."></textarea>
                            <span asp-validation-for="Instructions" class="text-danger small"></span>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Details" asp-route-id="@Model.ID" class="btn btn-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}