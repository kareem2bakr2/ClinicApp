@model ClinicApp.ViewModel.MedicalServiceViewModel

@{
    ViewData["Title"] = "Create Medical Service";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white">
                        <i class="bi bi-hospital me-2"></i>Create Medical Service
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-light">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="createMedicalServiceForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. Service Name & Discount -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-8">
                                <label asp-for="Name" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="Name" class="form-control form-control-sm" placeholder="e.g. Corporate Insurance Package" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="Discount" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <div class="input-group input-group-sm">
                                    <input asp-for="Discount" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="Discount" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 2. Contract Dates -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartDateContract" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                                <input asp-for="StartDateContract" type="date" class="form-control form-control-sm" />
                                <span asp-validation-for="StartDateContract" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDateContract" class="form-label fw-semibold"></label>
                                <input asp-for="EndDateContract" type="date" class="form-control form-control-sm" placeholder="Optional for ongoing contracts" />
                                <small class="text-muted extra-small">Leave empty if contract has no fixed expiration date.</small>
                                <span asp-validation-for="EndDateContract" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- 3. Description -->
                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Add contract details, eligibility terms, or special notes..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-sm btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Save Service
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}