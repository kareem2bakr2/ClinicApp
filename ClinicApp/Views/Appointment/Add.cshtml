@model ClinicApp.ViewModel.AppointmentCreateViewModel

@{
    ViewData["Title"] = "Create New Appointment";
}

<div class="container py-5 my-5 ">
    <partial name="_alerts" />

    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white">
                        <i class="bi bi-calendar-plus me-2"></i>Create New Appointment
                    </h5>
                    <a asp-action="Index" class="btn btn-sm btn-light">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Add" method="post" id="createAppointmentForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- 1. Patient Selection with Live Search -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Select Patient <span class="text-danger">*</span></label>
                            <input type="hidden" asp-for="Patientid" id="selectedPatientId" />
                            <span asp-validation-for="Patientid" class="text-danger d-block mb-1"></span>

                            <input type="text" id="patientSearchInput" class="form-control form-control-sm mb-2" placeholder="Search patient by name or phone..." />

                            <div class="border rounded bg-white p-2" style="max-height: 180px; overflow-y: auto;" id="patientListContainer">
                                @if (Model.AllPatietns != null && Model.AllPatietns.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var patient in Model.AllPatietns)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action patient-select-item py-2 px-3 border-0 rounded mb-1"
                                                    data-id="@patient.id"
                                                    data-name="@patient.Name"
                                                    data-phone="@patient.phone">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-semibold small">@patient.Name</span>
                                                    <span class="badge bg-light text-dark border">ID: #@patient.id</span>
                                                </div>
                                                <small class="text-muted d-block"><i class="bi bi-telephone me-1"></i>@patient.phone</small>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted small">No patients available.</div>
                                }
                            </div>
                        </div>
                        <!-- 3. Medical Service Selection with Live Search (Scrollable Div) -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Select Medical Service (Optional)</label>
                            <input type="hidden" asp-for="medicalServiceID" id="selectedMedicalServiceId" />

                            <input type="text" id="serviceSearchInput" class="form-control form-control-sm mb-2" placeholder="Search medical service by name..." />

                            <div class="border rounded bg-white p-2" style="max-height: 180px; overflow-y: auto;" id="serviceListContainer">
                                <div class="list-group list-group-flush">
                                    <!-- Option to clear/deselect medical service -->
                                    <button type="button"
                                            class="list-group-item list-group-item-action service-select-item py-2 px-3 border-0 rounded mb-1 active bg-secondary text-white"
                                            data-id=""
                                            data-name="None"
                                            data-discount="0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-semibold small">None (No Service Discount)</span>
                                            <span class="badge bg-light text-dark">0%</span>
                                        </div>
                                    </button>

                                    @if (Model.AllMedicalService != null && Model.AllMedicalService.Any())
                                    {
                                        @foreach (var service in Model.AllMedicalService)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action service-select-item py-2 px-3 border-0 rounded mb-1"
                                                    data-id="@service.ID"
                                                    data-name="@service.Name"
                                                    data-discount="@service.Discount">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-semibold small">@service.Name</span>
                                                    <span class="badge bg-info text-dark">@service.Discount.ToString("0.##")% Discount</span>
                                                </div>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <div class="text-center py-3 text-muted small">No medical services available.</div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- 2. Treatment Plan Selection with Live Search -->
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Select Treatment Plan <span class="text-danger">*</span></label>
                            <input type="hidden" asp-for="planID" id="selectedPlanId" />
                            <span asp-validation-for="planID" class="text-danger d-block mb-1"></span>

                            <input type="text" id="planSearchInput" class="form-control form-control-sm mb-2" placeholder="Search plan by name..." />

                            <div class="border rounded bg-white p-2" style="max-height: 180px; overflow-y: auto;" id="planListContainer">
                                @if (Model.AllPlans != null && Model.AllPlans.Any())
                                {
                                    <div class="list-group list-group-flush">
                                        @foreach (var plan in Model.AllPlans)
                                        {
                                            <button type="button"
                                                    class="list-group-item list-group-item-action plan-select-item py-2 px-3 border-0 rounded mb-1"
                                                    data-id="@plan.ID"
                                                    data-name="@plan.Name"
                                                    data-price="@(plan.Price ?? 0)"
                                                    data-sessions="@(plan.numberOfSession ?? 0)">
                                                <div class="d-flex justify-content-between align-items-center">
                                                    <span class="fw-semibold small">@plan.Name</span>
                                                    <span class="badge bg-primary text-white">$@(plan.Price?.ToString("0.00") ?? "0.00")</span>
                                                </div>
                                                <small class="text-muted d-block">
                                                    <i class="bi bi-layers me-1"></i>Sessions: @(plan.numberOfSession?.ToString() ?? "N/A")
                                                </small>
                                            </button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center py-3 text-muted small">No plans available.</div>
                                }
                            </div>
                        </div>



                        <!-- 4. Financial Calculations Overview (Auto Calculated) -->
                        <div class="card bg-light border mb-4">
                            <div class="card-header bg-white py-2">
                                <h6 class="mb-0 fw-bold text-secondary">
                                    <i class="bi bi-calculator me-1"></i> Price Breakdown
                                </h6>
                            </div>
                            <div class="card-body p-3">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted">Plan Base Price</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="text" id="displayBasePrice" class="form-control fw-bold" value="0.00" readonly />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="DiscountPercentage" class="form-label small text-muted"></label>
                                        <div class="input-group input-group-sm">
                                            <input type="number" step="0.01" asp-for="DiscountPercentage" id="discountPercentageInput" class="form-control fw-bold" readonly />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="Discount" class="form-label small text-muted">Discount Amount</label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" asp-for="Discount" id="discountAmountInput" class="form-control fw-bold text-danger" readonly />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <label asp-for="FinalPrice" class="form-label small text-muted"></label>
                                        <div class="input-group input-group-sm">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" asp-for="FinalPrice" id="finalPriceInput" class="form-control fw-bold text-success fs-6" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 5. Notes -->
                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label fw-semibold"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Add any special instructions or notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-sm btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Create Appointment
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            let selectedPlanPrice = 0;
            let selectedDiscountPct = 0;

            // -------------------------------------------------------------
            // 1. Patient Selection, Auto-Select & Live Search
            // -------------------------------------------------------------
            const patientItems = document.querySelectorAll(".patient-select-item");
            const patientSearchInput = document.getElementById("patientSearchInput");
            const selectedPatientIdInput = document.getElementById("selectedPatientId");

            function selectPatientItem(item) {
                patientItems.forEach(i => i.classList.remove("active", "bg-primary", "text-white"));
                item.classList.add("active", "bg-primary", "text-white");
                selectedPatientIdInput.value = item.getAttribute("data-id");
            }

            patientItems.forEach(item => {
                item.addEventListener("click", function() {
                    selectPatientItem(this);
                });
            });

            // Auto-select patient on page load if ID exists
            const preselectedPatientId = selectedPatientIdInput.value;
            if (preselectedPatientId) {
                const matchingPatient = Array.from(patientItems).find(
                    item => item.getAttribute("data-id") === preselectedPatientId
                );
                if (matchingPatient) {
                    selectPatientItem(matchingPatient);
                    matchingPatient.scrollIntoView({ block: "nearest", behavior: "smooth" });
                }
            }

            if (patientSearchInput) {
                patientSearchInput.addEventListener("input", function() {
                    const term = this.value.toLowerCase().trim();
                    patientItems.forEach(item => {
                        const name = (item.getAttribute("data-name") || "").toLowerCase();
                        const phone = (item.getAttribute("data-phone") || "").toLowerCase();
                        item.style.display = (name.includes(term) || phone.includes(term)) ? "" : "none";
                    });
                });
            }

            // -------------------------------------------------------------
            // 2. Treatment Plan Selection, Auto-Select & Live Search
            // -------------------------------------------------------------
            const planItems = document.querySelectorAll(".plan-select-item");
            const planSearchInput = document.getElementById("planSearchInput");
            const selectedPlanIdInput = document.getElementById("selectedPlanId");

            function selectPlanItem(item) {
                planItems.forEach(i => i.classList.remove("active", "bg-primary", "text-white"));
                item.classList.add("active", "bg-primary", "text-white");

                selectedPlanIdInput.value = item.getAttribute("data-id");
                selectedPlanPrice = parseFloat(item.getAttribute("data-price")) || 0;

                document.getElementById("displayBasePrice").value = selectedPlanPrice.toFixed(2);
                recalculateTotals();
            }

            planItems.forEach(item => {
                item.addEventListener("click", function() {
                    selectPlanItem(this);
                });
            });

            // Auto-select plan on page load if ID exists
            const preselectedPlanId = selectedPlanIdInput.value;
            if (preselectedPlanId) {
                const matchingPlan = Array.from(planItems).find(
                    item => item.getAttribute("data-id") === preselectedPlanId
                );
                if (matchingPlan) {
                    selectPlanItem(matchingPlan);
                    matchingPlan.scrollIntoView({ block: "nearest", behavior: "smooth" });
                }
            }

            if (planSearchInput) {
                planSearchInput.addEventListener("input", function() {
                    const term = this.value.toLowerCase().trim();
                    planItems.forEach(item => {
                        const name = (item.getAttribute("data-name") || "").toLowerCase();
                        item.style.display = name.includes(term) ? "" : "none";
                    });
                });
            }

            // -------------------------------------------------------------
            // 3. Medical Service Selection, Auto-Select & Live Search
            // -------------------------------------------------------------
            const serviceItems = document.querySelectorAll(".service-select-item");
            const serviceSearchInput = document.getElementById("serviceSearchInput");
            const selectedServiceIdInput = document.getElementById("selectedMedicalServiceId");

            function selectServiceItem(item) {
                serviceItems.forEach(i => i.classList.remove("active", "bg-primary", "bg-secondary", "text-white"));

                // Highlight secondary for 'None', primary for active services
                if (item.getAttribute("data-id") === "") {
                    item.classList.add("active", "bg-secondary", "text-white");
                } else {
                    item.classList.add("active", "bg-primary", "text-white");
                }

                selectedServiceIdInput.value = item.getAttribute("data-id");
                selectedDiscountPct = parseFloat(item.getAttribute("data-discount")) || 0;

                recalculateTotals();
            }

            serviceItems.forEach(item => {
                item.addEventListener("click", function() {
                    selectServiceItem(this);
                });
            });

            // Auto-select medical service on page load if ID exists
            const preselectedServiceId = selectedServiceIdInput.value;
            if (preselectedServiceId) {
                const matchingService = Array.from(serviceItems).find(
                    item => item.getAttribute("data-id") === preselectedServiceId
                );
                if (matchingService) {
                    selectServiceItem(matchingService);
                    matchingService.scrollIntoView({ block: "nearest", behavior: "smooth" });
                }
            }

            if (serviceSearchInput) {
                serviceSearchInput.addEventListener("input", function() {
                    const term = this.value.toLowerCase().trim();
                    serviceItems.forEach(item => {
                        const name = (item.getAttribute("data-name") || "").toLowerCase();
                        item.style.display = name.includes(term) ? "" : "none";
                    });
                });
            }

            // -------------------------------------------------------------
            // 4. Real-Time Price & Discount Calculations
            // -------------------------------------------------------------
            function recalculateTotals() {
                const discountAmount = selectedPlanPrice * (selectedDiscountPct / 100);
                const finalPrice = Math.max(0, selectedPlanPrice - discountAmount);

                document.getElementById("discountPercentageInput").value = selectedDiscountPct.toFixed(2);
                document.getElementById("discountAmountInput").value = discountAmount.toFixed(2);
                document.getElementById("finalPriceInput").value = finalPrice.toFixed(2);
            }
        });
    </script>
}