@model ConfirmEmailViewModel

@{
    ViewData["Title"] = "Confirm Email & Change Password";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 text-center">
                    <h5 class="mb-0 fw-bold text-white">
                        <i class="bi bi-shield-lock me-2"></i>Confirm Email & Set Password
                    </h5>
                </div>

                <div class="card-body p-4">
                    <form asp-action="ConfirmEmail" method="post" id="confirmEmailForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Hidden Route Parameters -->
                        <input type="hidden" asp-for="userId"  />
                        <input type="hidden" asp-for="token" />

                        <div class="text-muted small mb-4 text-center">
                            Please enter the temporary password sent to your email along with your new password to activate your account.
                        </div>

                        <!-- Password Fields -->
                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label fw-semibold">Temporary Password</label>
                            <input asp-for="OldPassword" type="password" class="form-control form-control-sm" placeholder="Enter temporary password" />
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                            <input asp-for="NewPassword" type="password" class="form-control form-control-sm" placeholder="Enter new password" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Confirm New Password</label>
                            <input asp-for="ConfirmNewPassword" type="password" class="form-control form-control-sm" placeholder="Re-enter new password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-sm btn-primary py-2">
                                <i class="bi bi-check-circle me-1"></i> Confirm & Change Password
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}