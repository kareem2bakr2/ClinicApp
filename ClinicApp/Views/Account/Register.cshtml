@using ClinicApp.ViewModel
@using ClinicApp.Models
@model RegisterViewModel

@{
    ViewData["Title"] = "Register New User";
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-white">
                        <i class="bi bi-person-plus-fill me-2"></i>Register Account
                    </h5>
                    <a asp-controller="Account" asp-action="Index" class="btn btn-sm btn-light">
                        <i class="bi bi-arrow-left me-1"></i> Back to Users
                    </a>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Register" method="post" id="registerUserForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Account Type Selection -->
                        <div class="mb-4">
                            <label asp-for="type" class="form-label fw-semibold">Account Type</label>
                            <select asp-for="type" id="accountTypeSelect" class="form-select form-select-sm">
                                <option value="">-- Select Account Type --</option>
                                <option value="@((int)AccountType.Receptionist)">@AccountType.Receptionist</option>
                                <option value="@((int)AccountType.Therapist)">@AccountType.Therapist</option>
                            </select>
                            <span asp-validation-for="type" class="text-danger"></span>
                        </div>

                        <!-- Basic Information Header (Fixed Spacing) -->
                        <div class="mt-4 pt-2 mb-3">
                            <h6 class="fw-bold text-primary m-0">
                                <i class="bi bi-person me-1"></i> Basic Details
                            </h6>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label fw-semibold"></label>
                                <input asp-for="Name" class="form-control form-control-sm" placeholder="Full Name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <input asp-for="Email" class="form-control form-control-sm" placeholder="example@domain.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <input asp-for="Phone" class="form-control form-control-sm" placeholder="+1234567890" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Gender" class="form-label fw-semibold"></label>
                                <select asp-for="Gender" class="form-select form-select-sm">
                                    <option value="">-- Select Gender --</option>
                                    <option value="Male">Male</option>
                                    <option value="Female">Female</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Dynamic Section: Receptionist Details -->
                        <div id="receptionistFields" style="display: none;">
                            <hr class="my-4" />
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-building me-1"></i> Receptionist Details</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label asp-for="Age" class="form-label fw-semibold"></label>
                                    <input asp-for="Age" type="number" class="form-control form-control-sm" placeholder="Age" />
                                    <span asp-validation-for="Age" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="WorktimeFrom" class="form-label fw-semibold"></label>
                                    <input asp-for="WorktimeFrom" type="time" class="form-control form-control-sm" />
                                    <span asp-validation-for="WorktimeFrom" class="text-danger"></span>
                                </div>

                                <div class="col-md-4">
                                    <label asp-for="WorkTimeTO" class="form-label fw-semibold"></label>
                                    <input asp-for="WorkTimeTO" type="time" class="form-control form-control-sm" />
                                    <span asp-validation-for="WorkTimeTO" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="Dayoff" class="form-label fw-semibold"></label>
                                    <select asp-for="Dayoff" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<DayOfWeek>()">
                                        <option value="">-- Select Day Off --</option>
                                    </select>
                                    <span asp-validation-for="Dayoff" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Dynamic Section: Therapist Details -->
                        <div id="therapistFields" style="display: none;">
                            <hr class="my-4" />
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-heart-pulse me-1"></i> Therapist Details</h6>
                            <div class="row g-3 mb-4">
                                <div class="col-md-6">
                                    <label asp-for="Specialization" class="form-label fw-semibold"></label>
                                    <select asp-for="Specialization" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<TherapistSpecialization>()">
                                        <option value="">-- Select Specialization --</option>
                                    </select>
                                    <span asp-validation-for="Specialization" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="SeniorityLevel" class="form-label fw-semibold"></label>
                                    <select asp-for="SeniorityLevel" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<SeniorityLevel>()">
                                        <option value="">-- Select Seniority Level --</option>
                                    </select>
                                    <span asp-validation-for="SeniorityLevel" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="hourRate" class="form-label fw-semibold">Hourly Rate</label>
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="hourRate" type="number" step="0.01" class="form-control" placeholder="0.00" />
                                    </div>
                                    <span asp-validation-for="hourRate" class="text-danger"></span>
                                </div>

                                <!-- Scrollable Therapist Manager Selector -->
                                <div class="col-12 mt-3">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-label fw-semibold mb-0">Manager / Supervisor</label>
                                        <small class="text-muted" id="selectedManagerBadge">None Selected</small>
                                    </div>

                                    <input type="text" id="therapistSearchInput" class="form-control form-control-sm mb-2" placeholder="Search manager by name..." />

                                    <div class="border rounded bg-white p-2" style="max-height: 200px; overflow-y: auto;" id="therapistListContainer">
                                        @if (Model?.AllTherapists != null && Model.AllTherapists.Any())
                                        {
                                            <div class="list-group list-group-flush">
                                                <!-- Option to clear selection -->
                                                <label class="list-group-item list-group-item-action therapist-item py-2 px-3 border-0 rounded mb-1 cursor-pointer">
                                                    <div class="form-check d-flex align-items-center gap-2 mb-0">
                                                        <input class="form-check-input therapist-radio me-2"
                                                               type="radio"
                                                               asp-for="ManagerID"
                                                               value=""
                                                               data-name="None" />
                                                        <span class="fw-semibold small text-muted">-- None / No Manager --</span>
                                                    </div>
                                                </label>

                                                @foreach (var therapist in Model.AllTherapists)
                                                {
                                                    bool isChecked = Model.ManagerID == therapist.ID;

                                                    <label class="list-group-item list-group-item-action therapist-item py-2 px-3 border-0 rounded mb-1 cursor-pointer @(isChecked ? "active bg-light text-dark" : "")">
                                                        <div class="form-check d-flex align-items-center gap-2 mb-0">
                                                            <input class="form-check-input therapist-radio me-2"
                                                                   type="radio"
                                                                   asp-for="ManagerID"
                                                                   value="@therapist.ID"
                                                                   data-name="@therapist.Name"
                                                                   checked="@isChecked" />
                                                            <div class="w-100">
                                                                <span class="fw-semibold small text-dark therapist-name">@therapist.Name</span>
                                                            </div>
                                                        </div>
                                                    </label>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-3 text-muted small">No therapists available.</div>
                                        }
                                    </div>
                                    <span asp-validation-for="ManagerID" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-controller="Account" asp-action="Index" class="btn btn-sm btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-sm btn-primary px-4">
                                <i class="bi bi-check-circle me-1"></i> Register Account
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Prevent jQuery unobtrusive validation from blocking hidden fields
            if ($.validator) {
                $.validator.setDefaults({ ignore: ":hidden" });
            }

            // 1. Toggle Section Visibility based on Dropdown
            function setSectionEnabled($section, enabled) {
                $section.find('input, select, textarea').prop('disabled', !enabled);
            }

            function toggleSections() {
                var val = $('#accountTypeSelect').val();

                if (val === "0") {
                    $('#receptionistFields').show();
                    $('#therapistFields').hide();
                    setSectionEnabled($('#receptionistFields'), true);
                    setSectionEnabled($('#therapistFields'), false);
                } else if (val === "2") {
                    $('#receptionistFields').hide();
                    $('#therapistFields').show();
                    setSectionEnabled($('#receptionistFields'), false);
                    setSectionEnabled($('#therapistFields'), true);
                } else {
                    $('#receptionistFields').hide();
                    $('#therapistFields').hide();
                    setSectionEnabled($('#receptionistFields'), false);
                    setSectionEnabled($('#therapistFields'), false);
                }
            }

            $(document).on('change', '#accountTypeSelect', function () {
                toggleSections();
            });

            toggleSections(); // Execute on initial load

            // 2. Manager Selection & Search Filter logic
            const managerRadios = document.querySelectorAll(".therapist-radio");
            const managerBadge = document.getElementById("selectedManagerBadge");
            const searchInput = document.getElementById("therapistSearchInput");
            const therapistItems = document.querySelectorAll(".therapist-item");

            function updateSelectedManager() {
                const checkedRadio = document.querySelector(".therapist-radio:checked");
                if (managerBadge) {
                    if (checkedRadio && checkedRadio.value !== "") {
                        managerBadge.textContent = "Selected: " + checkedRadio.getAttribute("data-name");
                    } else {
                        managerBadge.textContent = "None Selected";
                    }
                }
            }

            managerRadios.forEach(radio => {
                radio.addEventListener("change", function () {
                    therapistItems.forEach(item => item.classList.remove("active", "bg-light", "text-dark"));
                    if (this.checked) {
                        const label = this.closest(".therapist-item");
                        if (label) label.classList.add("active", "bg-light", "text-dark");
                    }
                    updateSelectedManager();
                });
            });

            updateSelectedManager(); // Initial badge display

            // Live Search Filter for Manager list
            if (searchInput) {
                searchInput.addEventListener("input", function () {
                    const term = this.value.toLowerCase().trim();
                    therapistItems.forEach(item => {
                        const text = item.textContent.toLowerCase();
                        item.style.display = text.includes(term) ? "" : "none";
                    });
                });
            }
        });
    </script>
}