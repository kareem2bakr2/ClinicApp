@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 my-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3 text-center">
                    <h5 class="mb-0 fw-bold text-white">
                        <i class="bi bi-shield-x me-2"></i>Access Denied
                    </h5>
                </div>
                <div class="card-body p-4 text-center">
                    <p class="text-muted mb-4">
                        You are signed in, but your account does not have permission to open this page.
                        Use the menu above to go to a page allowed for your role.
                    </p>
                    <a class="btn btn-sm btn-primary px-4" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-house-door me-1"></i> Go to Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
