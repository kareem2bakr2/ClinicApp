@using ClinicApp.ViewModel
@using ClinicApp.Models 
@model AccountIndexViewModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container py-5 my-4">
    <partial name="_alerts" />

    <!-- Top Card Header & Actions -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-white">
                <i class="bi bi-people-fill me-2"></i>User Management
            </h5>
            <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-light fw-semibold">
                <i class="bi bi-person-plus-fill me-1"></i> Register New User
            </a>
        </div>

        <div class="card-body p-4">
            <!-- Filter Form -->
            <form asp-action="Index" method="get" class="row g-3 align-items-end mb-4">
                <input type="hidden" name="PageIndex" value="1" />

                <div class="col-md-5">
                    <label class="form-label fw-semibold">Search User</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                        <input type="text" asp-for="SearchName" class="form-control" placeholder="Search by name, email, or username..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Filter by Role</label>
                    <select asp-for="TypeFilter" class="form-select form-select-sm" asp-items="Html.GetEnumSelectList<AccountType>()">
                        <option value="">-- All Roles --</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-fill">
                        <i class="bi bi-funnel me-1"></i> Filter
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                    </a>
                </div>
            </form>

            <!-- Users Table -->
            <div class="table-responsive">
                <table class="table table-hover align-middle border">
                    <thead class="table-light">
                        <tr>
                            <th>User / Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model?.allUsers != null && Model.allUsers.Any())
                        {
                            @foreach (var item in Model.allUsers)
                            {
                                string detailsController = item.type switch
                                {
                                    AccountType.Therapist => "Therapist",
                                    AccountType.Receptionist => "Receptionist",
                                    AccountType.Patient => "Patient",
                                    _ => "Account"
                                };

                                <tr id="user-row-@item.UserId">
                                    <td>
                                        <a asp-controller="@detailsController" asp-action="Details" asp-route-id="@item.id" class="fw-bold text-decoration-none text-primary">
                                            @(string.IsNullOrEmpty(item.username) ? item.email : item.username)
                                        </a>
                                    </td>
                                    <td><small class="text-muted">@item.email</small></td>
                                    <td>
                                        <span class="badge @(item.type == AccountType.Therapist ? "bg-info text-dark" : item.type == AccountType.Receptionist ? "bg-warning text-dark" : "bg-secondary")">
                                            @item.type
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <!-- Send Password Reset Token -->
                                            <button type="button" class="btn btn-outline-secondary btn-send-reset" data-email="@item.email" title="Send Password Reset Email">
                                                <i class="bi bi-key-fill me-1"></i> Reset Password
                                            </button>

                                            <!-- Delete User -->
                                            <button type="button" class="btn btn-outline-danger btn-delete-user" data-id="@item.UserId" data-name="@item.username" title="Delete User">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i> No users found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls -->
            @if (Model?.TotalCount > 1)
            {
                <nav class="d-flex justify-content-between align-items-center mt-3">
                    <small class="text-muted">Page @Model.PageIndex of @Model.TotalCount</small>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageIndex="@(Model.PageIndex - 1)" asp-route-SearchName="@Model.SearchName" asp-route-TypeFilter="@Model.TypeFilter">Previous</a>
                        </li>

                        @for (int i = 1; i <= Model.TotalCount; i++)
                        {
                            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-PageIndex="@i" asp-route-SearchName="@Model.SearchName" asp-route-TypeFilter="@Model.TypeFilter">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageIndex >= Model.TotalCount ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageIndex="@(Model.PageIndex + 1)" asp-route-SearchName="@Model.SearchName" asp-route-TypeFilter="@Model.TypeFilter">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill me-2"></i> Confirm Deletion</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete user <strong id="deleteUserName"></strong>? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger" id="confirmDeleteBtn">Delete User</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            let targetUserId = null;

            // 1. Trigger Delete Modal
            $('.btn-delete-user').on('click', function() {
                targetUserId = $(this).data('id');
                const userName = $(this).data('name'); $('#deleteUserName').text(userName);
                $('#deleteUserModal').modal('show');
            });

            // 2. Perform Delete via AJAX
            $('#confirmDeleteBtn').on('click', function() {
                if (!targetUserId) return;

                $.ajax({
                    url: '/Account/Delete',
                    type: 'GET',
                    data: { id: targetUserId },
                    success: function(res) {
                        $('#deleteUserModal').modal('hide');
                        if (res.flag) {
                            $(`#user-row-${targetUserId}`).fadeOut(300, function() { $(this).remove(); });
                        } else {
                            alert(res.message || 'Error occurred while deleting user.');
                        }
                    },
                    error: function() {
                        $('#deleteUserModal').modal('hide');
                        alert('Server error occurred.');
                    }
                });
            });

            // 3. Send Reset Password Email via AJAX
            $('.btn-send-reset').on('click', function() {
                const btn = $(this);
                const email = btn.data('email');

                if (!confirm(`Send password reset email to ${email}?`)) return;

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span> Sending...');

                $.ajax({
                    url: '/Account/SendResetToken',
                    type: 'GET',
                    data: { email: email },
                    success: function(res) {
                        alert(res.result);
                        btn.prop('disabled', false).html('<i class="bi bi-key-fill me-1"></i> Reset Password');
                    },
                    error: function() {
                        alert('Failed to send reset email.');
                        btn.prop('disabled', false).html('<i class="bi bi-key-fill me-1"></i> Reset Password');
                    }
                });
            });
        });
    </script>
}