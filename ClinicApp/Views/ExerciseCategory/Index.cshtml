@using ClinicApp.ViewModel
@model ExerciseCategoryIndexModelView

@{
    ViewData["Title"] = "Exercise Categories";
    int totalPages = (int)Math.Ceiling((double)Model.PagesCount / Model.PageSize);
    if (totalPages < 1) totalPages = 1;
}

<div class="container py-5 my-5">
    <partial name="_alerts" />

    <!-- Top Action Header -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3 py-3">
            <h5 class="mb-0 fw-bold text-secondary">
                <i class="bi bi-tags me-2 text-primary"></i>Exercise Categories Directory
            </h5>
            <button type="button" class="btn btn-sm btn-primary px-3" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="bi bi-plus-lg me-1"></i> New Category
            </button>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">
            <form asp-action="Index" method="get">
                <div class="row g-3 align-items-end">
                    <div class="col-md-8 col-lg-9">
                        <label asp-for="searchName" class="form-label fw-semibold small">Category Name</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                            <input asp-for="searchName" class="form-control" placeholder="Search categories..." />
                        </div>
                    </div>
                    <div class="col-md-4 col-lg-3 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary w-100">
                            <i class="bi bi-filter me-1"></i> Search
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-outline-secondary w-100">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> Reset
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Categories Table Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 15%;">ID</th>
                            <th>Category Name</th>
                            <th class="text-end" style="width: 25%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model._items != null && Model._items.Any())
                        {
                            foreach (var item in Model._items)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@item.ID</td>
                                    <td class="fw-bold text-dark">@item.Name</td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <button type="button"
                                                    class="btn btn-outline-info btn-details"
                                                    data-id="@item.ID"
                                                    title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-primary btn-edit"
                                                    data-id="@item.ID"
                                                    data-name="@item.Name"
                                                    title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-delete"
                                                    data-id="@item.ID"
                                                    data-name="@item.Name"
                                                    title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    <i class="bi bi-info-circle me-1"></i> No categories found matching your criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Server-Side Pagination -->
            @if (totalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination pagination-sm justify-content-center mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber - 1)"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-searchName="@Model.searchName">Previous</a>
                        </li>

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-PageNumber="@i"
                                   asp-route-PageSize="@Model.PageSize"
                                   asp-route-searchName="@Model.searchName">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= totalPages ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-PageNumber="@(Model.PageNumber + 1)"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-searchName="@Model.searchName">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

<!-- 1. CREATE CATEGORY MODAL -->
<div class="modal fade" id="createModal" tabindex="-1" aria-labelledby="createModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="createModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>New Category
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="createCategoryName" class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" id="createCategoryName" name="Name" class="form-control" placeholder="e.g., Strength, Cardio" required minlength="3" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">
                        <i class="bi bi-check-lg me-1"></i>Save Category
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 2. EDIT CATEGORY MODAL -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editCategoryId" name="ID" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="editModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>Edit Category
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label for="editCategoryName" class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                        <input type="text" id="editCategoryName" name="Name" class="form-control" required minlength="3" />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-sm btn-primary px-3">
                        <i class="bi bi-check-lg me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 3. DETAILS CATEGORY MODAL (Renders Linked Exercises) -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-labelledby="detailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-info text-dark">
                <h5 class="modal-title" id="detailsModalLabel">
                    <i class="bi bi-info-circle me-2"></i>Category Details
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <div id="detailsLoader" class="text-center py-3">
                    <div class="spinner-border text-info" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>

                <div id="detailsContent" class="d-none">
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold d-block">Category ID</label>
                        <span class="fw-bold fs-6" id="detailsCategoryId"></span>
                    </div>
                    <div class="mb-3">
                        <label class="text-muted small fw-semibold d-block">Category Name</label>
                        <span class="fw-bold fs-5 text-dark" id="detailsCategoryName"></span>
                    </div>

                    <!-- Linked Exercises List -->
                    <div>
                        <label class="text-muted small fw-semibold d-block mb-2">Associated Exercises</label>
                        <div id="detailsExercisesList" class="list-group max-vh-30 overflow-auto border rounded">
                            <!-- Populated via AJAX -->
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- 4. DELETE CONFIRMATION MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-4">
                <p class="mb-1">Are you sure you want to delete this category?</p>
                <p class="fw-bold text-dark mb-0" id="deleteItemName"></p>
                <small class="text-danger">This action cannot be undone and may affect linked exercises.</small>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteForm" asp-action="Delete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteItemId" name="id" value="" />
                    <button type="submit" class="btn btn-sm btn-danger px-3">
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            const editModal = new bootstrap.Modal(document.getElementById('editModal'));
            const detailsModal = new bootstrap.Modal(document.getElementById('detailsModal'));

            // Delete Modal Handling
            document.querySelectorAll('.btn-delete').forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');

                    document.getElementById('deleteItemId').value = id;
                    document.getElementById('deleteItemName').textContent = `"${name}" (#${id})`;

                    deleteModal.show();
                });
            });

            // Edit Modal Handling
            document.querySelectorAll('.btn-edit').forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name');

                    document.getElementById('editCategoryId').value = id;
                    document.getElementById('editCategoryName').value = name;

                    editModal.show();
                });
            });

            // Details Modal Handling (Fetches Name & Associated Exercises)
            document.querySelectorAll('.btn-details').forEach(button => {
                button.addEventListener('click', function() {
                    const id = this.getAttribute('data-id');

                    document.getElementById('detailsLoader').classList.remove('d-none');
                    document.getElementById('detailsContent').classList.add('d-none');

                    detailsModal.show();

                    fetch(`/ExerciseCategory/DetailsJson/${id}`)
                        .then(response => {
                            if (!response.ok) throw new Error("Failed to load details");
                            return response.json();
                        })
                        .then(data => {
                            document.getElementById('detailsCategoryId').textContent = `#${data.id}`;
                            document.getElementById('detailsCategoryName').textContent = data.name;

                            const exercisesListContainer = document.getElementById('detailsExercisesList');
                            exercisesListContainer.innerHTML = '';

                            const items = data._items || data.items || [];
                            if (items.length > 0) {
                                items.forEach(ex => {
                                    const itemHtml = `<div class="list-group-item d-flex justify-content-between align-items-center">
                                                <span class="fw-semibold text-dark">${ex.displayname}</span>
                                                <span class="badge bg-light text-muted border">#${ex.id}</span>
                                            </div>`;
                                    exercisesListContainer.insertAdjacentHTML('beforeend', itemHtml);
                                });
                            } else {
                                exercisesListContainer.innerHTML = `<div class="p-3 text-muted small text-center">No linked exercises found for this category.</div>`;
                            }

                            document.getElementById('detailsLoader').classList.add('d-none');
                            document.getElementById('detailsContent').classList.remove('d-none');
                        })
                        .catch(err => {
                            document.getElementById('detailsLoader').innerHTML = `<p class="text-danger mb-0">Error loading category details.</p>`;
                        });
                });
            });
        });
    </script>
}