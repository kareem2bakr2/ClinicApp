@{
    ViewData["Title"] = "Patients";
}
@model List<PatientListViewModel>



<div class="p-lg-5 my-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Patients</h2>
            <p class="text-muted mb-0">Manage and view all registered patients</p>
        </div>

        <a asp-controller="Patient"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Patient
        </a>
    </div>

    <!-- Search -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>

                        <input type="text"
                               id="patientSearch"
                               name="patientSearch"
                               class="form-control"
                               placeholder="Search patients..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <select class="form-select" id="statusFilter" name="statusFilter" >
                        <option value="">All Patients</option>
                        <option value="TodayPatients">Today's Patients</option>
                        <option value="PatientsWithAppointments">Patients with Appointments</option>
                    </select>
                </div>

            </div>
        </div>
    </div>

    <!-- Patient Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="patientsTable" >

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" >ID</th>
                            <th>Patient Name</th>
                            <th>Age</th>
                            <th>Next Session</th>
                            <th>Status</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Emergency Contact</th>
                            <th>Emergency Phone</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var patient in Model)
                        {
                            <tr>

                                <td class="ps-4 fw-semibold">
                                    @patient.Id
                                </td>

                                <td>
                                    <div class="d-flex align-items-center">
                                        @patient.Name
                                    </div>
                                </td>

                                <td>
                                    @patient.Age
                                </td>
                                <td>
                                    @patient.session?.SessionDate
                                </td>
                                <td>
                                    @patient.session?.SessionStatus
                                </td>
                                <td>
                                    @patient.Phone
                                </td>

                                <td>
                                    @patient.Email
                                </td>

                                <td>
                                    @patient.EmergencyContact
                                </td>
                                <td>
                                    @patient.EmergencyPhone
                                </td>
                                <td class="text-end pe-4">

                                    <div class="btn-group">

                                        <a asp-controller="Patient"
                                           asp-action="Details"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-secondary">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Patient"
                                           asp-action="Edit"
                                           asp-route-id="@patient.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>


                                        <button type="button" 
                                            class="btn btn-sm btn-outline-danger" 
                                            onclick="openDeleteModal('@patient.Id', '@patient.Name')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

        <!-- Empty state -->
        @if (!Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-people fs-1 text-muted"></i>

                <h5 class="mt-3">
                    No patients found
                </h5>

                <p class="text-muted">
                    Start by adding your first patient.
                </p>

                <a asp-controller="Patient"
                   asp-action="Create"
                   class="btn btn-primary">
                    Add Patient
                </a>

            </div>
        }

    </div>

    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            
            <div class="modal-header bg-danger ">
                <h5 class="modal-title fw-bold text-white" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i> Confirm Deletion
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 text-center">
                <p class="fs-5 mb-1">Are you sure you want to delete this patient?</p>
                <p class="fw-bold text-danger fs-5" id="deletePatientName"></p>
                <p class="text-muted small mb-0">This action cannot be undone.</p>
            </div>

            <div class="modal-footer bg-light justify-content-between">
                <!-- Cancel Button -->
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>

                <!-- Form sending POST request to ASP action -->
                <form asp-controller="Patient" asp-action="Delete" method="post" id="deletePatientForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deletePatientId" name="id" value="" />
    
                    <!-- Hidden inputs matching C# method parameters -->
                    <input type="hidden" id="deleteCurrentSearch" name="patientSearch" value="" />
                    <input type="hidden" id="deleteCurrentFilter" name="statusFilter" value="" />

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i> Delete Patient
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
</div>

@section Scripts {
    <script>
        // Global Modal Function
        function openDeleteModal(patientId, patientName) {
            const deleteIdEl = document.getElementById("deletePatientId");
            const deleteNameEl = document.getElementById("deletePatientName");
            const deleteModalEl = document.getElementById("deleteConfirmModal");

            if (deleteIdEl) deleteIdEl.value = patientId;
            if (deleteNameEl) deleteNameEl.textContent = patientName;

            const currentSearchVal = document.getElementById("patientSearch")?.value || "";
            const currentFilterVal = document.getElementById("statusFilter")?.value || "";

            const searchHidden = document.getElementById("deleteCurrentSearch");
            const filterHidden = document.getElementById("deleteCurrentFilter");

            if (searchHidden) searchHidden.value = currentSearchVal;
            if (filterHidden) filterHidden.value = currentFilterVal;

            if (deleteModalEl) {
                const deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalEl);
                deleteModal.show();
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("patientSearch");
            const statusFilter = document.getElementById("statusFilter");
            const table = document.getElementById("patientsTable");

            if (!table) return;

            const tableCard = table.closest(".card");
            const itemsPerPage = 50;
            let currentPage = 1;

            // 1. Create and append pagination controls
            const paginationContainer = document.createElement("div");
            paginationContainer.className = "card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center";
            paginationContainer.innerHTML = `
                <div class="text-muted small" id="pageInfo">Showing 0 to 0 of 0 entries</div>
                <ul class="pagination pagination-sm mb-0" id="paginationList"></ul>
            `;
            if (tableCard) tableCard.appendChild(paginationContainer);

            // 2. Define filter logic
            window.filterPatients = function() {
                const searchValue = searchInput ? searchInput.value.toLowerCase() : "";
                const statusValue = statusFilter ? statusFilter.value : "";
                const rows = Array.from(document.querySelectorAll("#patientsTable tbody tr"));

                const filteredRows = rows.filter(row => {
                    const rowText = row.innerText.toLowerCase();
                    const sessionDateText = row.cells[3] ? row.cells[3].textContent.trim() : "";
                    const haveAppointment = sessionDateText.length > 0;

                    const todayString = new Date().toLocaleDateString();
                    const today = sessionDateText.includes(todayString) || rowText.includes(todayString);

                    const matchesSearch = rowText.includes(searchValue);
                    let matchesStatus = true;

                    if (statusValue === "PatientsWithAppointments") matchesStatus = haveAppointment;
                    if (statusValue === "TodayPatients") matchesStatus = today && haveAppointment;

                    return matchesSearch && matchesStatus;
                });

                rows.forEach(row => row.style.display = "none");

                const totalItems = filteredRows.length;
                const totalPages = Math.ceil(totalItems / itemsPerPage) || 1;

                if (currentPage > totalPages) currentPage = totalPages;
                if (currentPage < 1) currentPage = 1;

                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = Math.min(startIndex + itemsPerPage, totalItems);

                for (let i = startIndex; i < endIndex; i++) {
                    if (filteredRows[i]) filteredRows[i].style.display = "";
                }

                const pageInfo = document.getElementById("pageInfo");
                if (pageInfo) {
                    pageInfo.textContent = totalItems > 0
                        ? `Showing ${startIndex + 1} to ${endIndex} of ${totalItems} entries`
                        : "Showing 0 to 0 of 0 entries";
                }

                renderPaginationControls(totalPages);
            };

            // 3. Define pagination UI renderer
            function renderPaginationControls(totalPages) {
                const paginationList = document.getElementById("paginationList");
                if (!paginationList) return;

                paginationList.innerHTML = "";
                if (totalPages <= 1) return;

                const prevLi = document.createElement("li");
                prevLi.className = `page-item ${currentPage === 1 ? 'disabled' : ''}`;
                prevLi.innerHTML = `<a class="page-link" href="#">Previous</a>`;
                prevLi.addEventListener("click", (e) => {
                    e.preventDefault();
                    if (currentPage > 1) {
                        currentPage--;
                        window.filterPatients();
                    }
                });
                paginationList.appendChild(prevLi);

                for (let i = 1; i <= totalPages; i++) {
                    const li = document.createElement("li");
                    li.className = `page-item ${i === currentPage ? 'active' : ''}`;
                    li.innerHTML = `<a class="page-link" href="#">${i}</a>`;
                    li.addEventListener("click", (e) => {
                        e.preventDefault();
                        currentPage = i;
                        window.filterPatients();
                    });
                    paginationList.appendChild(li);
                }

                const nextLi = document.createElement("li");
                nextLi.className = `page-item ${currentPage === totalPages ? 'disabled' : ''}`;
                nextLi.innerHTML = `<a class="page-link" href="#">Next</a>`;
                nextLi.addEventListener("click", (e) => {
                    e.preventDefault();
                    if (currentPage < totalPages) {
                        currentPage++;
                        window.filterPatients();
                    }
                });
                paginationList.appendChild(nextLi);
            }

            // 4. Attach input listeners (Native + jQuery/nice-select support)
            if (searchInput) searchInput.addEventListener("input", () => { currentPage = 1; window.filterPatients(); });
            
            if (statusFilter) {
                statusFilter.addEventListener("change", () => { currentPage = 1; window.filterPatients(); });
                // Support jQuery/nice-select change events
                if (window.jQuery) {
                    $(statusFilter).on("change", () => { currentPage = 1; window.filterPatients(); });
                }
            }

            // 5. Restore saved values from TempData
            const initialSearch = @Json.Serialize(TempData["patientSearch"]);
            const initialStatus = @Json.Serialize(TempData["statusFilter"]);

            if (searchInput && initialSearch) searchInput.value = initialSearch;
            if (statusFilter && initialStatus) {
                statusFilter.value = initialStatus;
                if (window.jQuery && $.fn.niceSelect) {
                    $(statusFilter).niceSelect('update'); // Refresh custom nice-select UI
                }
            }

            // 6. Run initial filtering pass
            window.filterPatients();
        });
    </script>
}