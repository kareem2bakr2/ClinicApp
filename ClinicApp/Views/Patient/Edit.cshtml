@model PatientEditViewModel

@{
    ViewData["Title"] = "Update Security & Contact Info";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="card-title fw-bold mb-0 text-white">
                        <i class="bi bi-shield-lock me-2"></i> Account Security
                    </h4>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" asp-route-id ="@Model.ID" id="profileForm">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>

                        <!-- ================= CONTACT DETAILS ================= -->
                        <h5 class="fw-bold text-secondary mb-3">
                            <i class="bi bi-person-lines-fill me-2"></i> Contact Information
                        </h5>

                        <div class="row g-3 mb-4">
                            <!-- Phone -->
                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="Phone" class="form-control" placeholder="e.g. +1234567890" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <!-- Address -->
                            <div class="col-12">
                                <label asp-for="Address" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Address" class="form-control" placeholder="Street address, City, State" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <!-- ================= EMERGENCY CONTACT ================= -->
                        <h5 class="fw-bold text-danger mb-3">
                            <i class="bi bi-exclamation-triangle me-2"></i> Emergency Contact
                        </h5>

                        <div class="row g-3 mb-4">
                            <!-- Emergency Contact Name -->
                            <div class="col-md-6">
                                <label asp-for="EmergencyContact" class="form-label fw-semibold">Contact Name</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                    <input asp-for="EmergencyContact" class="form-control" placeholder="Full name" />
                                </div>
                                <span asp-validation-for="EmergencyContact" class="text-danger small"></span>
                            </div>

                            <!-- Relationship -->
                            <div class="col-md-6">
                                <label asp-for="EmergencyRelationShip" class="form-label fw-semibold">Relationship</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-people"></i></span>
                                    <input asp-for="EmergencyRelationShip" class="form-control" placeholder="e.g. Parent, Spouse, Sibling" />
                                </div>
                                <span asp-validation-for="EmergencyRelationShip" class="text-danger small"></span>
                            </div>

                            <!-- Emergency Phone -->
                            <div class="col-12">
                                <label asp-for="EmergencyPhone" class="form-label fw-semibold">Emergency Phone</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-danger"><i class="bi bi-telephone-plus"></i></span>
                                    <input asp-for="EmergencyPhone" class="form-control" placeholder="Emergency contact number" />
                                </div>
                                <span asp-validation-for="EmergencyPhone" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4 text-muted opacity-25" />

                        <!-- ================= PASSWORD CHANGE TOGGLE ================= -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h5 class="fw-bold text-secondary mb-0">
                                <i class="bi bi-key me-2"></i> Password Update
                            </h5>

                            <!-- Checkbox for changePaassword -->
                            <div class="form-check form-switch">
                                <input asp-for="changePassword" class="form-check-input" id="changePasswordToggle" type="checkbox" role="switch" />
                                <label class="form-check-label fw-semibold" for="changePasswordToggle">
                                    Change Password
                                </label>
                            </div>
                        </div>

                        <!-- PASSWORD FIELDS CONTAINER -->
                        <div id="passwordFieldsContainer" class="row g-3 mb-4 d-none">
                            <!-- Old Password -->
                            <div class="col-12">
                                <label asp-for="oldPassword" class="form-label fw-semibold">Current Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                                    <input asp-for="oldPassword" class="form-control" placeholder="Enter current password" />
                                </div>
                                <span asp-validation-for="oldPassword" class="text-danger small"></span>
                            </div>

                            <!-- New Password -->
                            <div class="col-md-6">
                                <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-shield-lock"></i></span>
                                    <input asp-for="NewPassword" class="form-control" id="newPasswordInput" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <!-- Confirm New Password -->
                            <div class="col-md-6">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-shield-check"></i></span>
                                    <input asp-for="ConfirmNewPassword" class="form-control" placeholder="••••••••" />
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex justify-content-end gap-2 pt-3">
                            <a asp-controller="Patient" asp-action="Index" class="btn btn-outline-secondary px-4">
                                Cancel
                            </a>
                            <span class="pr-2"></span>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-save me-1"></i> Save Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const toggle = document.getElementById("changePasswordToggle");
            const container = document.getElementById("passwordFieldsContainer");

            function togglePasswordFields() {
                if (toggle.checked) {
                    container.classList.remove("d-none");
                } else {
                    container.classList.add("d-none");
                    // Clear inputs when unchecked
                    container.querySelectorAll("input").forEach(input => input.value = "");
                }
            }

            if (toggle && container) {
                // Initialize visibility on page load (handles validation postbacks)
                togglePasswordFields();

                // Listen for checkbox toggle
                toggle.addEventListener("change", togglePasswordFields);
            }
        });
    </script>
}