@model ClinicApp.ViewModel.TherapistCreateViewModel
@using ClinicApp.Models // Ensure your Enum namespace is referenced

@{
    ViewData["Title"] = "Create Therapist Profile";
}

<div class="container py-4 my-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="card-title mb-0 fw-bold">
                <i class="bi bi-person-plus me-2"></i>Create New Therapist
            </h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Section 1: Basic & Contact Information -->
                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-person me-2"></i>Personal & Contact Information</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Fisrt Name" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-semibold"></label>
                        <input asp-for="LastName" class="form-control" placeholder="Last Name" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="userName" class="form-label fw-semibold"></label>
                        <input asp-for="userName" class="form-control" placeholder="UserName" />
                        <span asp-validation-for="userName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="therapist@clinic.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="01012282233" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label fw-semibold"></label>
                        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<Gender>()" class="form-select">
                            <option value="">-- Select Gender --</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger small"></span>
                    </div>

                    <!-- Profile Photo File Input -->
                    <div class="col-md-12">
                        <label asp-for="Photo" class="form-label fw-semibold">Profile Photo</label>
                        <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                        <small class="form-text text-muted">Allowed formats: .png, .jpg, .jpeg (Max size: 5 MB)</small>
                        <span asp-validation-for="Photo" class="text-danger small d-block"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 2: Professional Details -->
                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-briefcase me-2"></i>Professional Information</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="SeniorityLevel" class="form-label fw-semibold"></label>
                        <select asp-for="SeniorityLevel" asp-items="Html.GetEnumSelectList<SeniorityLevel>()" class="form-select">
                            <option value="">-- Select Seniority Level --</option>
                        </select>
                        <span asp-validation-for="SeniorityLevel" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="hourRate" class="form-label fw-semibold"></label>
                        <input asp-for="hourRate" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" />
                        <span asp-validation-for="hourRate" class="text-danger small"></span>
                    </div>

                    <!-- Bitwise Flag Enum Selection for Specializations -->
                    <div class="col-12">
                        <label class="form-label fw-semibold d-block">Specialization (Select all that apply)</label>
                        <div class="card bg-light border-0 p-3">
                            <div class="row g-2">
                                @foreach (TherapistSpecialization spec in Enum.GetValues(typeof(TherapistSpecialization)))
                                {
                                    // Skip 'None' or 0 value if defined in your Enum
                                    if ((int)spec == 0) continue;

                                    bool isChecked = Model != null && Model.Specialization.HasFlag(spec);

                                    <div class="col-md-4 col-sm-6">
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="SelectedSpecializations"
                                                   value="@((int)spec)"
                                                   id="spec_@((int)spec)"
                                            @(isChecked ? "checked" : "") />
                                            <label class="form-check-label" for="spec_@((int)spec)">
                                                @spec.ToString()
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 3: Credentials -->
                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-shield-lock me-2"></i>Account Security</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <input asp-for="Password" class="form-control" placeholder="Enter password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Form Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>Create Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}