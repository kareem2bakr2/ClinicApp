@model TherapistEditViewModel


@{
    ViewData["Title"] = "Edit Therapist";
}

<div class="container py-4 my-4">
    <partial name="_alerts" />

    <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white py-3">
            <h4 class="card-title mb-0 fw-bold">
                <i class="bi bi-pencil-square me-2"></i>Edit Therapist Profile
            </h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <!-- Hidden Inputs -->
                <input type="hidden" asp-for="DBId" />
                <input type="hidden" asp-for="AppId" />
                <input type="hidden" asp-for="PhotoURL" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Section 1: Contact Information -->
                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-person me-2"></i>Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label asp-for="Photo" class="form-label fw-semibold"></label>
                        <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="Photo" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@clinic.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Phone" class="form-label fw-semibold"></label>
                        <input asp-for="Phone" class="form-control" placeholder="+1234567890" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 2: Professional Details -->
                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-briefcase me-2"></i>Professional Details</h5>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="SeniorityLevel" class="form-label fw-semibold"></label>
                        <select asp-for="SeniorityLevel" asp-items="Html.GetEnumSelectList<SeniorityLevel>()" class="form-select">
                            <option value="">-- Select Seniority Level --</option>
                        </select>
                        <span asp-validation-for="SeniorityLevel" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="hourRate" class="form-label fw-semibold"></label>
                        <input asp-for="hourRate" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="hourRate" class="text-danger small"></span>
                    </div>

                    <!-- Bitwise Flag Enum Checkboxes for Specialization -->
                    <div class="col-12">
                        <label class="form-label fw-semibold d-block">Specialization (Select all that apply)</label>
                        <div class="card bg-light border-0 p-3">
                            <div class="row g-2">
                                @foreach (TherapistSpecialization spec in Enum.GetValues(typeof(TherapistSpecialization)))
                                {
                                    // Skip 'None' or 0 value if defined in Enum
                                    if ((int)spec == 0) continue;

                                    bool isChecked = Model != null && Model.Specialization.HasFlag(spec);

                                    <div class="col-md-4 col-sm-6">
                                        <div class="form-check">
                                            <input class="form-check-input specialization-checkbox"
                                                   type="checkbox"
                                                   name="SelectedSpecializations"
                                                   value="@((int)spec)"
                                                   id="spec_@((int)spec)"
                                            @(isChecked ? "checked" : "") />
                                            <label class="form-check-label" for="spec_@((int)spec)">
                                                @spec.ToString()
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <span asp-validation-for="Specialization" class="text-danger small"></span>
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Section 3: Password Toggle Section -->
                <h5 class="fw-bold text-secondary mb-3"><i class="bi bi-shield-lock me-2"></i>Security Settings</h5>
                <div class="mb-3">
                    <div class="form-check form-switch">
                        <input asp-for="changePasword" class="form-check-input" type="checkbox" id="changePasswordToggle" />
                        <label asp-for="changePasword" class="form-check-label fw-semibold cursor-pointer" for="changePasswordToggle">
                            Change Password
                        </label>
                    </div>
                </div>

                <!-- Password Fields Container (Hidden by default) -->
                <div class="card bg-light border-0 p-3 mb-4 d-none" id="passwordSection">
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label asp-for="OldPassword" class="form-label fw-semibold">Current Password</label>
                            <input asp-for="OldPassword" class="form-control password-field" disabled placeholder="Enter current password" />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label fw-semibold">New Password</label>
                            <input asp-for="NewPassword" class="form-control password-field" disabled placeholder="Min 8 chars, 1 upper, 1 lower, 1 digit, 1 special" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-semibold">Confirm New Password</label>
                            <input asp-for="ConfirmNewPassword" class="form-control password-field" disabled placeholder="Re-enter new password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Details" asp-route-id="@Model.DBId" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle me-1"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-circle me-1"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const passwordToggle = document.getElementById("changePasswordToggle");
            const passwordSection = document.getElementById("passwordSection");
            const passwordInputs = document.querySelectorAll(".password-field");

            function togglePasswordFields() {
                if (passwordToggle && passwordToggle.checked) {
                    passwordSection.classList.remove("d-none");
                    passwordInputs.forEach(input => input.removeAttribute("disabled"));
                } else if (passwordSection) {
                    passwordSection.classList.add("d-none");
                    passwordInputs.forEach(input => {
                        input.setAttribute("disabled", "disabled");
                        input.value = "";
                    });
                }
            }

            if (passwordToggle) {
                passwordToggle.addEventListener("change", togglePasswordFields);
            }

            // Sync initial state on load (e.g., if re-rendered after a model validation failure)
            togglePasswordFields();
        });
    </script>
}